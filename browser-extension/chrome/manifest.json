{
  "manifest_version": 3,
  "name": "Captain for Chrome",
  "short_name": "Captain",
  "version": "0.1.0",
  "description": "Send the page you're on to one of your Captain agents — summarize it, keep it with its files, pull out its data, or ask about it.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Send to Captain",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "sidePanel",
    "activeTab",
    "scripting",
    "storage",
    "contextMenus",
    "pageCapture",
    "tabs"
  ],
  "optional_host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+C"
      },
      "description": "Open Captain beside the page"
    }
  },
  "minimum_chrome_version": "116"
}
