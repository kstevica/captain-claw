{
  "name": "captain-claw",
  "version": "0.8.11",
  "description": "Captain Claw – AI Agentic System",
  "main": "main.js",
  "author": "Stevica Kuharski <kstevica@gmail.com>",
  "homepage": "https://github.com/kstevica/captain-claw",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "dist:linux": "electron-builder --linux",
    "dist:full": "electron-builder --config electron-builder.full.js"
  },
  "dependencies": {
    "electron-log": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0"
  },
  "build": {
    "appId": "com.captainclaw.desktop",
    "productName": "Captain",
    "afterPack": "./adhoc-sign.js",
    "directories": {
      "output": "../dist/desktop",
      "buildResources": "icons"
    },
    "files": [
      "main.js",
      "preload.js",
      "runtime.js",
      "setup.html",
      "assets/**/*",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icons/icon.icns",
      "target": [
        "dmg"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Captain",
      "background": "icons/dmg-background.png",
      "iconSize": 112,
      "window": {
        "width": 660,
        "height": 428
      },
      "contents": [
        {
          "x": 180,
          "y": 196
        },
        {
          "x": 480,
          "y": 196,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "icon": "icons/icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "linux": {
      "icon": "icons",
      "category": "Development",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ]
    },
    "electronLanguages": [
      "en",
      "en-US"
    ]
  }
}
