# Model API Keys
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
GOOGLE_API_KEY=""
GEMINI_API_KEY=""

# Ollama (if using local models)
OLLAMA_BASE_URL="http://localhost:11434"

# Configuration overrides
CLAW_MODEL__PROVIDER="openai"
CLAW_MODEL__MODEL="gpt-4o-mini"
CLAW_MODEL__BASE_URL=""
CLAW_GUARDS__INPUT__ENABLED="false"
CLAW_GUARDS__INPUT__LEVEL="stop_suspicious"
CLAW_GUARDS__OUTPUT__ENABLED="false"
CLAW_GUARDS__OUTPUT__LEVEL="stop_suspicious"
CLAW_GUARDS__SCRIPT_TOOL__ENABLED="false"
CLAW_GUARDS__SCRIPT_TOOL__LEVEL="stop_suspicious"
CLAW_LOGGING__LEVEL="INFO"

# User's local timezone for the agent's sense of "now" (IANA name). The server
# clock is UTC; set this so the agent shows the user's local date/time and
# reasons about today/tomorrow/this week correctly. Equivalent to
# CLAW_CONTEXT__TIMEZONE; falls back to TZ, then UTC-only if unset.
CLAW_TZ="Europe/Zagreb"

# Mailgun
MAILGUN_API_KEY="mailgun api key"
MAILGUN_DOMAIN="mailgun domain"
MAIL_FROM_ADDRESS="mail from address"
MAIL_FROM_NAME="Captain Claw"

# http://localhost:23080/auth/google/callback
GOOGLE_OAUTH_ENABLED=false
GOOGLE_OAUTH_CLIENT_ID=...
GOOGLE_OAUTH_CLIENT_SECRET=...

# Tavily (web search, when tools.web_search.provider=tavily)
TAVILY_API_KEY=""

# Interactive terminal / PTY bridge
# Shared secret for the terminal daemon ↔ Flight Deck relay ↔ agent tool.
# Generate one: python -c "import secrets; print(secrets.token_hex(32))"
CLAW_PTY_TOKEN=""
# Agent → relay: where the `terminal` tool sends ops. For the NAT dial-out
# setup, point it at FD's relay for your worker (FD + agent are co-located):
#   CLAW_PTY_URL="http://127.0.0.1:25080/fd/pty/mac"
# Leave unset to talk to a local daemon directly (http://127.0.0.1:23190).
CLAW_PTY_URL=""

# Terminal proactive watcher (agent-side). Notices when an interactive
# session parks at a prompt while the agent is idle, then uses a pure LLM
# call to auto-answer safe/obvious prompts or ask the user.
CLAW_TERMINAL_WATCH="1"            # 0 to disable the watcher entirely
CLAW_TERMINAL_WATCH_AUTO="1"       # 0 = never auto-answer, always ask the user
# CLAW_TERMINAL_WATCH_QUIET="6"    # seconds of quiet before it evaluates
# CLAW_TERMINAL_WATCH_INTERVAL="3" # poll cadence (seconds)
# CLAW_TERMINAL_WATCH_MAX_AUTO="3" # consecutive auto-answers before handing to the user
